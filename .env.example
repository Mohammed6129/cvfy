# =============================================================================
# CVfy — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, add these variables in:
#   Project Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Authentication)
# Get these from: https://supabase.com/dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase key — legacy anon JWT (eyJ...) or new publishable key (sb_publishable_...)
# Copy from Supabase Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Or use the newer variable name (either works):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Service role key — server/scripts only, never expose in the browser
# Supabase Dashboard → Settings → API Keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# REQUIRED for the paywall to be enforced on the server: with it, CV rows and
# payment state are read/written only by the server (see supabase/migrations).
# Run supabase/schema.sql in the SQL Editor on a new project.

# App URL used for OAuth redirects (no trailing slash)
# Local: http://localhost:3000
# Production (Vercel): https://cvfy-rosy.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth — configure in Supabase dashboard:
#   1. Authentication → URL Configuration:
#      Site URL: https://your-domain.vercel.app
#      Redirect URLs:
#        - http://localhost:3000/auth/callback
#        - https://your-domain.vercel.app/auth/callback
#   2. Authentication → Providers → Google:
#      Enable Google, add Client ID + Client Secret from Google Cloud Console
#      Google redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#   3. Run supabase/schema.sql in SQL Editor to create the cvs table
#   4. Authentication → Providers → Phone: enable and configure SMS (Twilio, etc.)

# -----------------------------------------------------------------------------
# Anthropic (AI — interview questions, CV writing, CV upload parsing)
# Get your key from: https://console.anthropic.com/
# Server-side only — do NOT prefix with NEXT_PUBLIC_
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — override the models without a code change.
# Defaults: claude-sonnet-5-5 (writing) and claude-haiku-5-5 (extraction).
# ANTHROPIC_MODEL_WRITER=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Optional — how hard the writer model thinks: low (default, fastest) | medium | high.
# Raise it only together with maxDuration in app/api/cv/generate/route.ts.
# CVFY_WRITER_EFFORT=low

# -----------------------------------------------------------------------------
# Moyasar (Payments)
# Get your key from: https://dashboard.moyasar.com/
# Use pk_live_ on production (HTTPS) or pk_test_ for staging
# Moyasar only works over HTTPS — payment is disabled on http://localhost
# -----------------------------------------------------------------------------

NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_live_your-moyasar-publishable-key

# REQUIRED — secret key (sk_live_... / sk_test_...), server-side only.
# Every payment is looked up at Moyasar with this key before a CV is unlocked.
# Without it payments are accepted WITHOUT verification (a warning is logged).
MOYASAR_SECRET_KEY=sk_live_your-moyasar-secret-key

# Optional — required for Google Pay button (from Google Pay Business Console)
# NEXT_PUBLIC_MOYASAR_GOOGLE_MERCHANT_ID=your-google-merchant-id

# Optional — Moyasar gateway merchant ID for Google Pay
# NEXT_PUBLIC_MOYASAR_GATEWAY_MERCHANT_ID=your-gateway-merchant-id

# -----------------------------------------------------------------------------
# Local development without any external service (never active in production)
#   CVFY_MOCK=1 npm run dev   →  canned AI answers, in-memory storage,
#                                 a "دخول تجريبي" button and a test-pay button.
# -----------------------------------------------------------------------------
# CVFY_MOCK=1
